# ─── Básico ───────────────────────────────────────────────────────────────────
PORT=4000

# URL pública deste backend, SEM barra no final. É com ela que o link do e-mail é montado.
# Local:      http://localhost:4000
# Hospedado:  https://con-crm.up.railway.app  (ou o domínio que a hospedagem te der)
APP_URL=http://localhost:4000

# Endereço do CRM (Netlify) que pode chamar esta API. Use * enquanto testa.
FRONTEND_ORIGIN=*

# Segredo que assina o login. Troque por um texto longo e aleatório em produção.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Código que o corretor usa para vincular a conta à Conecta (vai no link de cadastro).
# Mudar aqui e reiniciar invalida os links antigos.
ADM_CODE=CONECTA-JAZ-2026
ORG_NAME=Conecta Imóveis

# Conta de administração criada no primeiro start (só se ainda não existir nenhuma
# com esse e-mail). Depois de criada, pode apagar estas três linhas.
ADM_NAME=Ali
ADM_EMAIL=
ADM_PASSWORD=

# Caminho do banco. Na hospedagem, aponte para o disco persistente (ex.: /data/concrm.db).
# DB_PATH=/data/concrm.db

# ─── E-mail de confirmação do cadastro (Resend) ───────────────────────────────
# Enquanto estiver vazio, o cadastro continua funcionando: o link de confirmação
# aparece na tela e no log do servidor, para a ADM repassar na mão.
# 1) Crie a conta em resend.com  2) Verifique o domínio da Conecta  3) Gere a API key.
RESEND_API_KEY=
MAIL_FROM=Conecta Imóveis <nao-responda@seudominio.com.br>

# ─── Fotos e vídeos dos imóveis ───────────────────────────────────────────────
# Sem as variáveis abaixo, os arquivos ficam no disco da hospedagem (ao lado do
# banco). Funciona, mas o volume é pequeno — bom para fotos, apertado para vídeo.
#
# Preenchendo as quatro, o sistema passa a usar o Cloudflare R2 sozinho, sem
# mexer em mais nada. Onde achar cada uma, no painel do R2:
#   R2_ACCOUNT_ID        → visão geral da conta (Account ID)
#   R2_ACCESS_KEY_ID     → Manage R2 API Tokens > Create API Token
#   R2_SECRET_ACCESS_KEY → aparece uma única vez, junto com a chave acima
#   R2_BUCKET            → nome do bucket que você criar (ex.: comhub)
#   R2_PUBLIC_URL        → Settings > Public access (r2.dev ou domínio próprio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── Cópia de segurança do banco ──────────────────────────────────────────────
# O banco é UM ARQUIVO no disco da hospedagem, com os leads de todas as contas
# dentro. Todo dia de madrugada ele é copiado para o mesmo R2 acima — fora do
# servidor, que é o ponto: cópia guardada no mesmo disco some junto com ele.
#
# Por isso a cópia SÓ acontece com o R2 preenchido. Sem ele o sistema não grava
# no disco "para não ficar sem nada": ficaria com a impressão de estar protegido
# sem estar. O aviso aparece no hub, na seção Cópia de segurança.
#
# As duas variáveis abaixo são opcionais — os padrões servem.
BACKUP_HORA=3       # hora do dia (0-23) em que a cópia roda. Padrão: 3 da manhã
BACKUP_MANTER=30    # quantas cópias diárias ficam guardadas. Padrão: 30

# ─── Meta Lead Ads ────────────────────────────────────────────────────────────
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ─── WhatsApp (Uazapi) ────────────────────────────────────────────────────────
UAZAPI_HOST=
UAZAPI_TOKEN=

# Endereço do SITE (o domínio que a equipe acessa). É ele que sai no link de
# definir senha enviado ao corretor. Diferente do APP_URL, que é o do servidor
# e continua servindo os arquivos das conversas.
SITE_URL=https://conhubcrm.com.br

# Leitura automática do print da simulação da Caixa (opcional). Sem a chave, o
# corretor registra a simulação na mão e nada quebra.
ANTHROPIC_API_KEY=

# Cobrança da mensalidade (Asaas). Sem a chave, a assinatura funciona no modo
# manual: o gestor marca "pago" e o vencimento anda um mês.
ASAAS_API_KEY=
ASAAS_SANDBOX=true
# Token que você define no painel do Asaas ao cadastrar o webhook. Sem ele,
# qualquer um poderia chamar nossa rota dizendo que a mensalidade foi paga.
ASAAS_WEBHOOK_TOKEN=

# Armazenamento no Cloudflare R2 (recomendado). Sem estas variáveis os arquivos
# ficam no disco da hospedagem, no mesmo volume do banco — e disco cheio derruba
# o CRM inteiro, não só o envio de fotos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domínio público do bucket. Sem ele o arquivo sobe mas não abre para ninguém.
R2_PUBLIC_URL=
