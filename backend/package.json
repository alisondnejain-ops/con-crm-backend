{
  "name": "con-crm-backend",
  "version": "1.0.0",
  "description": "Backend do Con CRM — Conecta Imóveis (leads Meta + WhatsApp via Uazapi, catraca da SDR e funil automático)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "migrar-r2": "node src/migrar-r2.js",
    "teste:imobiliarias": "node testes/imobiliarias.mjs",
    "teste:dono": "node testes/dono-imobiliaria.mjs",
    "teste:whatsapp": "node testes/whatsapp-por-imobiliaria.mjs",
    "teste:apagar": "node testes/apagar-imobiliaria.mjs",
    "teste": "npm run teste:imobiliarias && npm run teste:dono && npm run teste:whatsapp && npm run teste:apagar && npm run teste:resumo && npm run teste:iauso && npm run teste:funil && npm run teste:etapa-ia",
    "teste:resumo": "node testes/resumo-ia.mjs",
    "teste:iauso": "node testes/uso-ia.mjs",
    "teste:funil": "node testes/diagnostico-funil.mjs",
    "teste:etapa-ia": "node testes/etapa-ia.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
