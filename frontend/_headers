# Cabeçalhos para o Cloudflare Pages (o Netlify usa o netlify.toml da raiz).
#
# O index.html é um arquivo único e o nome dele nunca muda. Sem isto, o navegador
# guarda a versão antiga e o corretor continua vendo o sistema desatualizado
# depois de uma publicação.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# O service worker é o pior arquivo para ficar preso em cache: uma versão velha
# dele continuaria mandando notificação com o comportamento antigo, e o
# navegador só troca quando o arquivo muda.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# O arquivo que diz qual versão está publicada. Cache aqui seria o próprio
# problema que ele existe para diagnosticar.
/versao.txt
  Cache-Control: no-store
